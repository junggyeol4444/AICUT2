{
  "_note": [
    "The keys each editor uses, as this program will press them.",
    "`confirmed` is what it says: true only where the key was read from the copy",
    "installed on this machine, which is the one the editor actually obeys.",
    "A key learned from the program's own source is what the editor ships with -",
    "not what this person set it to - so it stays false until it is read here.",
    "`source` says where each one came from. An entry with no source was never",
    "learned at all: it is the documented default written down by hand, which is",
    "not the same as measured.",
    "Run `--learn` to fill this in, and `--dry-run` to see every key before one",
    "is pressed. Correct what is wrong here; the file is the thing to edit."
  ],
  "shotcut": {
    "name": "Shotcut",
    "window": [
      "Shotcut"
    ],
    "settle_sec": 0.5,
    "keys": {
      "new_timeline": {
        "key": "ctrl+n",
        "key_mac": "cmd+n",
        "confirmed": false,
        "note": "new project; Shotcut has one timeline per project",
        "source": "the program's own source: https://raw.githubusercontent.com/mltframework/shotcut/master/src/mainwindow.ui"
      },
      "confirm": {
        "key": "return",
        "confirmed": false
      },
      "focus_source": {
        "key": "escape",
        "confirmed": false,
        "note": "leave whatever field has focus before the marks"
      },
      "goto_timecode": {
        "key": "ctrl+g",
        "key_mac": "cmd+g",
        "confirmed": false,
        "note": "if there is no such shortcut the position field is clicked instead"
      },
      "mark_in": {
        "key": "i",
        "confirmed": false,
        "source": "the program's own source: https://raw.githubusercontent.com/mltframework/shotcut/master/src/player.cpp"
      },
      "mark_out": {
        "key": "o",
        "confirmed": false,
        "source": "the program's own source: https://raw.githubusercontent.com/mltframework/shotcut/master/src/player.cpp"
      },
      "append": {
        "key": "a",
        "confirmed": false,
        "source": "the program's own source: https://raw.githubusercontent.com/mltframework/shotcut/master/src/docks/timelinedock.cpp"
      },
      "save": {
        "key": "ctrl+s",
        "key_mac": "cmd+s",
        "confirmed": false,
        "source": "the program's own source: https://raw.githubusercontent.com/mltframework/shotcut/master/src/mainwindow.ui"
      }
    },
    "learn": {
      "map": {
        "new_timeline": "actionNew",
        "mark_in": "playerSetInAction",
        "mark_out": "playerSetOutAction",
        "append": "timelineAppendAction",
        "save": "actionSave"
      },
      "sources": [
        [
          "https://raw.githubusercontent.com/mltframework/shotcut/master/src/mainwindow.ui",
          "qt-ui"
        ],
        [
          "https://raw.githubusercontent.com/mltframework/shotcut/master/src/player.cpp",
          "qt-source"
        ],
        [
          "https://raw.githubusercontent.com/mltframework/shotcut/master/src/docks/timelinedock.cpp",
          "qt-source"
        ]
      ]
    }
  },
